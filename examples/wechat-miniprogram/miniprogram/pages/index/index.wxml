<view class="stage">
  <canvas
    type="2d"
    id="orbit-canvas"
    class="scene"
    bindtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchCancel"
  ></canvas>

  <view class="hud-top" wx:if="{{ready}}">
    <view class="title">{{title}}</view>
    <view class="sub">
      {{angleText}} · 第 {{frameText}} 帧<text wx:if="{{missing > 0}}"> · 缺帧 {{missing}}</text>
    </view>
  </view>

  <view wx:if="{{!ready && !loading && !error}}" class="empty">
    <view class="empty-title">导入 .orb 场景</view>
    <view class="empty-text">
      先把 .orb 文件发送到微信聊天（例如「文件传输助手」），再点下方按钮选择。
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="progress"><view class="bar" style="width: {{progress}}%;"></view></view>
    <view class="progress-text">{{progress}}% · 解码帧</view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="hud-bottom">
    <view class="hint" wx:if="{{ready}}">左右拖拽旋转 · 倾斜手机环视</view>
    <view class="controls" wx:if="{{ready}}">
      <view class="btn {{auto ? 'on' : ''}}" bindtap="toggleAuto">自动环绕</view>
      <view class="btn {{gyro ? 'on' : ''}}" bindtap="toggleGyro">陀螺仪</view>
      <view class="btn" bindtap="toggleFit">{{fitText}}</view>
    </view>
    <view class="btn import" bindtap="importScene">＋ 导入 .orb 场景</view>
  </view>
</view>
