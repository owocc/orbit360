{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit360",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "apps/playground/dist/server/server.js",
  "assets": {
    "directory": "apps/playground/dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
